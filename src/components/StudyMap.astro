---
import { studyTopics, topicUrl } from "@/config/studyConfig";

interface Props {
	compact?: boolean;
}
const { compact = false } = Astro.props;
---
<section class:list={["study-map card-base onload-animation", { compact }]} aria-labelledby="study-map-heading">
  <div class="map-heading">
    <div><p class="eyebrow">A NOTEBOOK IN PROGRESS</p><h2 id="study-map-heading" class="text-90">学习地图<span class="text-50"> / Study map</span></h2></div>
    {compact && <a class="map-more" href="/topics/">浏览全部栏目 ↗</a>}
  </div>
  <p class="map-intro text-50">从定义走向推导，从阅读走向表达。沿着一条线索，慢慢把知识连起来。</p>
  <div class="topic-grid">
    {studyTopics.map(topic => <a class="topic-card" href={topicUrl(topic.name)}>
      <span class="topic-number">{topic.mark}</span><div><h3 class="text-90">{topic.name}</h3>{!compact && <p class="text-50">{topic.description}</p>}</div><span class="topic-arrow" aria-hidden="true">↗</span>
    </a>)}
  </div>
  {!compact && <div class="reading-path text-50"><h3 class="text-90">一条可以参考的阅读线索</h3><p>实分析 → 泛函分析 → 偏微分方程 → 流体力学 → Euler / N–S 方程</p><p>微分几何提供另一种观察空间与运动的视角；英语与西语笔记则记录阅读、表达和复习。</p></div>}
</section>
<style>
 .study-map { padding: 2rem; margin-bottom: 1.25rem; }
 .eyebrow { font-size: .65rem; letter-spacing: .2em; color: var(--primary); margin-bottom: .6rem; font-weight: 700; }
 .map-heading { display: flex; align-items: center; justify-content: space-between; gap: 1rem; }
 h2 { font-size: 1.6rem; font-weight: 700; letter-spacing: -.03em; }
 h2 span { font-weight: 400; font-size: .85rem; margin-left: .4rem; letter-spacing: 0; }
 .map-more { color: var(--primary); font-size: .8rem; white-space: nowrap; }
 .map-intro { font-size: .88rem; line-height: 1.8; margin: .75rem 0 1.4rem; }
 .topic-grid { display: grid; grid-template-columns: repeat(2,minmax(0,1fr)); gap: .6rem; }
 .topic-card { display: flex; gap: .8rem; align-items: flex-start; border: 1px solid var(--line-divider); border-radius: .75rem; padding: 1.1rem; transition: background .2s, border-color .2s; }
 .topic-card:hover, .topic-card:focus-visible { background: var(--btn-regular-bg); border-color: var(--primary); }
 .topic-number { font-family: monospace; font-size: .72rem; color: var(--primary); padding-top: .3rem; }
 h3 { font-size: 1rem; font-weight: 600; }
 .topic-card p { font-size: .8rem; line-height: 1.7; margin-top: .4rem; }
 .topic-arrow { margin-left: auto; color: var(--primary); }
 .compact .topic-grid { grid-template-columns: repeat(3,minmax(0,1fr)); }
 .compact .topic-card { padding: .8rem; align-items: center; }
 .compact h3 { font-size: .86rem; }
 .compact .topic-number { padding-top: 0; }
 .reading-path { border-top: 1px solid var(--line-divider); padding-top: 1.5rem; margin-top: 1.5rem; }
 .reading-path p { font-size: .85rem; line-height: 1.9; margin-top: .5rem; }
 @media(max-width: 640px) { .study-map { padding: 1.25rem; } .compact .topic-grid { grid-template-columns: repeat(2,minmax(0,1fr)); } h2 span { display: none; } .topic-grid { grid-template-columns: 1fr; } }
</style>

